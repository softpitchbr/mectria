{
  "name": "hub-mectria",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.api.json --noEmit",
    "build": "npm run typecheck && vite build",
    "test:app": "vitest run",
    "test:api": "vitest run --config vitest.api.config.ts --passWithNoTests",
    "test": "npm run test:app && npm run test:api",
    "e2e:preparar": "wrangler d1 migrations apply hub-mectria --local && wrangler d1 execute hub-mectria --local --file e2e/semente.sql",
    "e2e": "npm run e2e:preparar && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router": "7.18.5",
    "jose": "6.2.15",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.8.71",
    "@cloudflare/workers-types": "4.20250906.0",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4",
    "wrangler": "4.35.0"
  }
}
